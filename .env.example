# Copiar a .env.local y rellenar con las claves reales (NO subir a git).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM vía OpenRouter (provider-agnostic)
OPENROUTER_API_KEY=
# Modelos (opcionales — se afinan con el benchmark de comprobantes)
AI_MODEL_VISION=google/gemini-2.5-flash
AI_MODEL_VISION_FALLBACK=anthropic/claude-haiku-4.5
AI_MODEL_TEXTO=google/gemini-2.5-flash

# WhatsApp Cloud API (cuando el número esté registrado)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Firma del webhook (App Secret de Meta)
META_APP_SECRET=

# Crons (Vercel manda Authorization: Bearer ${CRON_SECRET})
CRON_SECRET=
# Interruptor del envío masivo del estado de cuenta ("on" para activarlo)
ENVIOS_MASIVOS=
# Devengo diario: fecha mínima (YYYY-MM-DD) desde la que se pueden rellenar
# días pasados. Definir SOLO al importar la cartera real (no con datos de prueba).
DEVENGO_DESDE=

# GPS Diacor (rastreo.diacorserver.com)
DIACOR_USER=
DIACOR_PASSWORD=
# Opcional; por defecto ya apunta a su servidor
# DIACOR_HOST=rastreo.diacorserver.com
# En Pro: GPS_SNAPSHOT_PRO=on y agregue a vercel.json los crons de
# vercel.crons-pro.gps.json (mañana 14:00 UTC y noche 02:00 UTC).
# Hobby solo corre la tarde (20:00 UTC ≈ 3 p.m. Panamá).
# GPS_SNAPSHOT_PRO=
